APP_ENV=development
API_PORT=8080
DATABASE_URL=postgres://fluenthub:fluenthub@localhost:5432/fluenthub?sslmode=disable
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me
STORAGE_PATH=./data/storage
MAX_UPLOAD_MB=50
LOG_LEVEL=info
DEFAULT_LOCALE=pt-BR
DEFAULT_TIMEZONE=America/Sao_Paulo
LIVE_CLASS_PROVIDER=mock
BILLING_PROVIDER=mock

# Real providers (select livekit/asaas above to enable)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=

# Storage security. Generate a unique base64-encoded 32-byte key outside Git.
STORAGE_ENCRYPTION_KEY=
STORAGE_ALLOW_LEGACY_PLAINTEXT=false
MALWARE_SCANNER=disabled
CLAMAV_ADDRESS=clamav:3310
BACKUP_PATH=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_HOURS=720
